{
  "version": 1,
  "application": "infra/argocd/application.yaml",
  "inputs": [
    {
      "name": "APP_SUBDOMAIN",
      "label": "Public subdomain (@ for apex)",
      "type": "subdomain",
      "default": "thoughty"
    }
  ],
  "files": [
    ".gitlab-ci.yml",
    ".github/workflows/sync-gitlab.yml",
    "sonar-project.properties",
    "infra/argocd/application.yaml",
    "infra/k8s/overlays/bm-cluster/kustomization.yaml",
    "infra/k8s/overlays/bm-cluster/configmap-patch.yaml",
    "infra/k8s/overlays/bm-cluster/ingress-patch.yaml",
    "infra/k8s/overlays/bm-cluster/api-ingress-patch.yaml",
    "infra/k8s/overlays/bm-cluster/database-setup-job.yaml",
    "infra/k8s/overlays/bm-cluster/observability.yaml"
  ],
  "replacements": [
    {
      "from": "targetRevision: main",
      "to": "targetRevision: {{DEFAULT_BRANCH}}"
    },
    {
      "from": "http://gitlab.swirlit.internal/swirlit/thoughty.git",
      "to": "{{GITLAB_REPOSITORY_URL}}"
    },
    {
      "from": "https://gitlab.swirlit.dev/swirlit/thoughty.git",
      "to": "{{GITLAB_PUBLIC_URL}}/{{GITLAB_PROJECT_PATH}}.git"
    },
    {
      "from": "http://gitlab.swirlit.internal",
      "to": "{{GITLAB_INTERNAL_URL}}"
    },
    {
      "from": "https://gitlab.swirlit.dev",
      "to": "{{GITLAB_PUBLIC_URL}}"
    },
    {
      "from": "gitlab-registry.swirlit.internal:5050",
      "to": "{{REGISTRY_PUSH_HOST}}"
    },
    {
      "from": "registry.swirlit.dev/swirlit/bm-cluster/security",
      "to": "{{REGISTRY_HOST}}/{{PLATFORM_SECURITY_PROJECT_PATH}}"
    },
    {
      "from": "registry.swirlit.dev/swirlit/thoughty",
      "to": "{{REGISTRY_HOST}}/{{GITLAB_PROJECT_PATH}}"
    },
    {
      "from": "thoughty.swirlit.dev",
      "to": "{{APP_HOST}}"
    },
    {
      "from": "keycloak.swirlit.dev",
      "to": "keycloak.{{PUBLIC_DOMAIN}}"
    },
    {
      "from": "swirlit.internal",
      "to": "{{INTERNAL_DNS_ZONE}}"
    },
    {
      "from": "realms/swirlit",
      "to": "realms/{{KEYCLOAK_REALM}}"
    },
    {
      "from": "swirlit-dev-tls",
      "to": "{{TLS_SECRET_NAME}}"
    },
    {
      "from": "swirlit:thoughty",
      "to": "{{SONAR_PROJECT_KEY}}"
    }
  ],
  "registry": {
    "path": "apps/thoughty/registry"
  },
  "vault": [
    {
      "path": "apps/thoughty/database",
      "fields": {
        "POSTGRES_USER": {
          "value": "thoughty"
        },
        "POSTGRES_PASSWORD": {
          "generate": 24,
          "encoding": "hex"
        },
        "POSTGRES_DB": {
          "value": "journal"
        }
      }
    },
    {
      "path": "apps/thoughty/app",
      "fields": {
        "JWT_SECRET": {
          "generate": 48,
          "encoding": "hex"
        },
        "REFRESH_SECRET": {
          "generate": 48,
          "encoding": "hex"
        },
        "TWO_FACTOR_SECRET": {
          "generate": 32,
          "encoding": "hex"
        },
        "CONFIG_ENCRYPTION_SECRET": {
          "generate": 32,
          "encoding": "hex"
        },
        "S3_ACCESS_KEY": {
          "value": ""
        },
        "S3_SECRET_KEY": {
          "value": ""
        },
        "OPENROUTER_API_KEY": {
          "value": ""
        },
        "GOOGLE_DRIVE_CLIENT_ID": {
          "value": ""
        },
        "GOOGLE_DRIVE_CLIENT_SECRET": {
          "value": ""
        },
        "ONEDRIVE_CLIENT_ID": {
          "value": ""
        },
        "ONEDRIVE_CLIENT_SECRET": {
          "value": ""
        },
        "DROPBOX_CLIENT_ID": {
          "value": ""
        },
        "DROPBOX_CLIENT_SECRET": {
          "value": ""
        },
        "SMTP_HOST": {
          "value": ""
        },
        "SMTP_USER": {
          "value": ""
        },
        "SMTP_PASS": {
          "value": ""
        },
        "SMTP_FROM": {
          "value": ""
        },
        "SMTP_PORT": {
          "value": "587"
        }
      }
    },
    {
      "path": "apps/thoughty/backup",
      "fields": {
        "POSTGRES_BACKUP_ACCESS_KEY": {
          "value": ""
        },
        "POSTGRES_BACKUP_SECRET_KEY": {
          "value": ""
        }
      }
    }
  ],
  "dns": {
    "hosts": [
      "{{APP_HOST}}"
    ]
  },
  "pipeline": {
    "variables": {
      "APP_ONBOARDING": "true"
    },
    "jobs": [
      "01-build",
      "03-package",
      "01-release",
      "02-deploy"
    ]
  },
  "readiness": {
    "deployments": [
      "thoughty-server",
      "thoughty-web",
      "thoughty-cloud-sync-worker"
    ]
  }
}
