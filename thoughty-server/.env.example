# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=journal
POSTGRES_POOL_MAX=10
POSTGRES_POOL_IDLE_TIMEOUT_MS=30000
POSTGRES_POOL_CONNECTION_TIMEOUT_MS=5000

# JWT Configuration
# In production (NODE_ENV=production) the server refuses to start unless JWT_SECRET and
# REFRESH_SECRET are set, are not these example values, and are at least 32 characters long.
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m
REFRESH_SECRET=refresh-secret-change-in-production
REFRESH_EXPIRES_IN=7d
TWO_FACTOR_SECRET=two-factor-secret-change-in-production

# Google sign-in (optional): the OAuth client ID the web app uses (VITE_GOOGLE_CLIENT_ID).
# The server verifies Google ID tokens against it; Google sign-in is refused when it is empty.
GOOGLE_CLIENT_ID=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Thoughty <your-email@gmail.com>"

# Environment
NODE_ENV=development
PORT=3001

# Proxies whose X-Forwarded-For is trusted, so rate limits key on the real client IP.
# Express syntax: true/false, a hop count (e.g. 2), or a comma list of IPs/CIDRs and
# loopback, linklocal, uniquelocal. Unset: none in development; in production
# "loopback, linklocal, uniquelocal". Never use true: clients could spoof their address.
TRUST_PROXY=

# Distributed rate limiting (optional)
# Leave unset for process-local throttling in single-instance local development.
# REDIS_URL=redis://localhost:6379/0
REDIS_HOST=
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_TLS=false

# S3 / Object Storage
# Defaults below work with the local RustFS from docker-compose (no .env needed for local dev)
# For production, use AWS S3 or any S3-compatible provider — see README for details
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=thoughty-attachments
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Deleted accounts
# Days a deleted account is kept before the worker purges it with all its data and files (default 30)
ACCOUNT_PURGE_AFTER_DAYS=30

# Config encryption (required in production for personal AI keys and integration tokens)
CONFIG_ENCRYPTION_SECRET=your-encryption-secret-change-in-production

# AI (OpenRouter)
# Optional shared key; users can provide personal keys from Profile
# Get an API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_TAG_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Cloud Sync OAuth (optional — required only if you want cloud sync)
# Google Drive: https://console.cloud.google.com/apis/credentials
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
# OneDrive: https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
# Dropbox: https://www.dropbox.com/developers/apps
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
