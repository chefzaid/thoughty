{
  "name": "thoughty-server",
  "version": "1.22.0",
  "description": "NestJS Backend for Thoughty Journal App",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:cloud-sync-worker": "node dist/src/cloud-sync-worker.js",
    "cloud-sync-worker": "npx ts-node -r tsconfig-paths/register src/cloud-sync-worker.ts",
    "lint": "tsc --noEmit -p tsconfig.json && eslint \"{src,scripts,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:e2e:cov": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --coverage --passWithNoTests --config ./test/jest-e2e.json",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "db:migrate": "npx ts-node -r tsconfig-paths/register scripts/migrate.ts",
    "db:migrate:dist": "node dist/scripts/migrate.js",
    "db:validate-seed": "npx ts-node -r tsconfig-paths/register scripts/seed.ts --validate-only",
    "db:seed": "npx ts-node -r tsconfig-paths/register scripts/seed.ts",
    "db:check": "npx ts-node -r tsconfig-paths/register scripts/check-db.ts",
    "db:nuke": "npx ts-node -r tsconfig-paths/register scripts/nuke-db.ts",
    "kill-node": "npx ts-node scripts/kill-node.ts",
    "coverage-report": "npx ts-node scripts/coverage-report.ts",
    "openapi:export": "npx ts-node -r tsconfig-paths/register scripts/export-openapi.ts",
    "benchmark": "npx ts-node -r tsconfig-paths/register scripts/benchmark.ts",
    "chaos:check": "npx ts-node -r tsconfig-paths/register scripts/resilience-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "helmet": "^8.3.0",
    "jszip": "^3.10.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "uuid": "^11.1.1",
    "xss": "^1.0.17"
  },
  "overrides": {
    "multer": "$multer"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "jest-junit": "^17.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/*.spec.ts",
      "!**/*.test-helpers.ts",
      "!**/*.module.ts",
      "!main.ts",
      "!**/index.ts",
      "!**/dto/**",
      "!**/entities/**",
      "!database/data-source.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^@modules/(.*)$": "<rootDir>/modules/$1",
      "^@common/(.*)$": "<rootDir>/common/$1",
      "^@database/(.*)$": "<rootDir>/database/$1"
    }
  },
  "allowScripts": {
    "@scarf/scarf": false,
    "fsevents@2.3.3": true
  }
}
