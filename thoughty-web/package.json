    "micromatch": {
      "picomatch": "^2.3.2"
    },
    "vite": {
      "picomatch": "^4.0.4",
      "rollup": "^4.59.0"
    },
    "vitest": {
      "picomatch": "^4.0.4"
    },
    "tinyglobby": {
      "picomatch": "^4.0.4"
    },
    "fdir": {
      "picomatch": "^4.0.4"
    },
    "js-yaml": "4.3.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
