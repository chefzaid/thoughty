{
  "name": "thoughty-web",
  "private": true,
  "version": "1.22.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e:install": "node ./scripts/install-playwright.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "api:types": "node ./scripts/generate-api-types.mjs",
    "api:usage": "node ./scripts/check-api-usage.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
